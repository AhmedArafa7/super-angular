rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin/reviewer
    function isReviewer() {
      return request.auth != null && 
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'founder', 'cofounder', 'management', 'reviewer']);
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // ==============================
    // Users Collection
    // ==============================
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ==============================
    // Videos Collection (Whitelist)
    // ==============================
    match /videos/{videoId} {
      // Anyone can read published videos
      allow read: if resource.data.status == 'published' || isReviewer();
      
      // Authenticated users can create videos with status 'pending_review'
      allow create: if isAuthenticated() && request.resource.data.status == 'pending_review';
      
      // Only admins/reviewers can update or delete
      allow update, delete: if isReviewer();
    }

    // ==============================
    // Blacklisted Channels Collection
    // ==============================
    match /blacklisted_channels/{channelId} {
      allow read, write: if isReviewer();
    }

    // ==============================
    // Reports Collection
    // ==============================
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isReviewer();
    }

    // ==============================
    // Subscriptions (user-channel pairs)
    // ==============================
    match /subscriptions/{subId} {
      allow read, write: if isAuthenticated() && request.auth.uid == subId.split('_')[0];
    }

    // ==============================
    // Game Invites
    // ==============================
    match /game_invites/{inviteId} {
      allow read: if isAuthenticated() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid;
    }

    // ==============================
    // System Metadata
    // ==============================
    // ==============================
    // Meeting Rooms & Participants
    // ==============================
    match /meeting_rooms/{roomId} {
      allow read, create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;

      match /participants/{participantId} {
        allow read, write: if isAuthenticated();
      }

      match /signaling/{signalId} {
        allow read, write: if isAuthenticated();
      }

      match /signaling_host_candidates/{candId} {
        allow read, write: if isAuthenticated();
      }

      match /signaling_guest_candidates/{candId} {
        allow read, write: if isAuthenticated();
      }

      match /messages/{messageId} {
        allow read, create: if isAuthenticated();
      }
    }
  }
}