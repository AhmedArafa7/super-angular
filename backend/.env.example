# GitHub App Credentials (Configured in Render or local backend/.env)
# Create your GitHub App at https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Private key can be passed either as raw PEM string (with \n) or path to a .pem file
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Backend Server Settings
PORT=3000
NODE_ENV=development
